---
import type { GalleryItem } from "../config/gallery";
import SectionTitle from "./SectionTitle.astro";

interface Props {
  id?: string;
  title: string;
  items: GalleryItem[];
}

const { id, title, items } = Astro.props;
---

<section id={id} class="anchor-target pt-2">
  <div class="site-container">
    <div class="mb-[14px] mt-2 flex items-end justify-between">
      <SectionTitle title={title} />
    </div>

    <div class="grid grid-cols-2 gap-4 max-[479px]:grid-cols-1 xl:grid-cols-5">
      {items.map((item) => (
        item.href ? (
          <a
            href={item.href}
            target="_blank"
            rel="noreferrer"
            class="group relative aspect-video overflow-hidden rounded-2xl border border-[#ecd8c7] bg-white shadow-soft transition-transform duration-200 hover:-translate-y-1"
          >
            <img
              src={item.src}
              alt={item.alt}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
            <div class="absolute inset-x-0 bottom-0 bg-[linear-gradient(180deg,rgba(53,19,13,0)_0%,rgba(53,19,13,0.88)_100%)] px-4 pb-3 pt-8 text-white">
              <div class="grid grid-cols-[1fr_auto] grid-rows-[auto_auto] items-end gap-x-3 gap-y-0.5">
                <div class="text-sm font-bold tracking-[0.04em] leading-none">{item.caption || "查看图集"}</div>
                <div class="row-span-2 self-end rounded-full border border-white/35 bg-white/10 px-3.5 py-1.5 text-[10px] font-bold tracking-[0.04em] leading-none backdrop-blur-sm">
                  点击查看
                </div>
                <div class="text-xs leading-none text-white/80">点击查看完整内容</div>
              </div>
            </div>
          </a>
        ) : (
          <div class="aspect-video overflow-hidden rounded-2xl border border-[#ecd8c7] bg-white shadow-soft">
            <img
              src={item.src}
              alt={item.alt}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        )
      ))}
    </div>
  </div>
</section>
