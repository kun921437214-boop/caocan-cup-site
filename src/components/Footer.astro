  <div class="site-container py-7">
    <div class="flex flex-wrap items-center justify-between gap-4 text-[15px] leading-[1.6] opacity-95 max-[520px]:justify-center max-[520px]:gap-2 max-[520px]:text-center max-[520px]:text-[13px]">
