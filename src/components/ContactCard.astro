---
import type { ContactItem } from "../config/home";
import { getGoPath, linksMap } from "../config/links";

interface Props {
  id?: string;
  title: string;
  items: ContactItem[];
}

const { id, title, items } = Astro.props;
const officialAccount = linksMap["official-account"];
---

<article id={id} class="card-panel anchor-target h-full">
  <div class="mb-[14px] flex items-center justify-between">
    <div class="card-title">{title}</div>
  </div>

  <div class="mt-2 grid items-start gap-[18px] grid-cols-[minmax(0,1fr)_120px] max-[399px]:grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(132px,168px)]">
    <div class="flex flex-col gap-[14px]">
      {items.map((item) => (
        <div class="grid min-w-0 grid-cols-[24px_1fr] gap-[10px]">
          <div class="contact-icon">{item.icon}</div>
          <div>
            <div class="text-sm text-[#8c7c70]">{item.label}</div>
            <div class="mt-0.5 break-words text-base leading-[1.45] text-[#4b4039]">
              {item.value}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="flex flex-col items-center gap-2 pt-6 md:-ml-[8px] md:pt-8">
      <a class="qr-link max-[520px]:max-w-[120px] max-[520px]:gap-2 max-[520px]:px-2.5 max-[520px]:py-3" href={getGoPath(officialAccount.key)}>
        {officialAccount.qrImage ? (
          <img
            src={officialAccount.qrImage}
            alt={officialAccount.label}
            class="h-[108px] w-[108px] rounded-[14px] border-8 border-[#fff4ea] object-cover shadow-[0_8px_20px_rgba(165,101,48,0.12)] max-[520px]:h-[84px] max-[520px]:w-[84px] max-[520px]:border-[6px]"
          />
        ) : (
          <div class="qr-placeholder max-[520px]:h-[84px] max-[520px]:w-[84px] max-[520px]:border-[6px] max-[520px]:text-[10px]">公众号二维码占位</div>
        )}

        <div class="text-center text-sm font-semibold text-[#7d4e35] max-[520px]:text-[12px]">{officialAccount.label}</div>
      </a>
    </div>
  </div>
</article>
