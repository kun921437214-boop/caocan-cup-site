---
import { links } from "../../config/links";
import { siteConfig } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return links.map((link) => ({
    params: { key: link.key },
    props: { link }
  }));
}

const { link } = Astro.props;
const canAutoRedirect = link.type === "web" && link.enabled && Boolean(link.href);
const qrImage = link.qrImage;
const isScanGuide = link.type !== "web";

const typeCopy = {
  web: {
    eyebrow: "网页跳转",
    title: `正在前往 ${link.label}`,
    description: link.href
      ? "页面已为你预留统一中转能力，稍后会自动跳转，也可以手动继续访问。"
      : "该入口已预留，但真实网页链接尚未配置。后续只需在 links.ts 中补上 href 即可启用。"
  },
  miniprogram: {
    eyebrow: "小程序入口",
    title: link.miniProgramAppName || link.label || "小程序名称占位",
    description: link.note || "请使用微信扫码打开小程序。"
  },
  wechat_article: {
    eyebrow: "公众号文章入口",
    title: link.label || "文章标题占位",
    description: link.note || "请使用微信扫码或在微信内打开文章。"
  },
  official_account: {
    eyebrow: "官方公众号入口",
    title: link.label || "公众号名称占位",
    description: link.note || "请使用微信扫码关注公众号。"
  }
}[link.type];

const guideTitle =
  link.type === "miniprogram"
    ? `微信扫码进入${link.label}`
    : link.type === "wechat_article"
      ? "微信扫码查看文章"
      : "微信扫码访问";

const guideDescription =
  link.type === "miniprogram"
    ? "当前入口已切换为二维码访问模式，请直接使用微信扫一扫进入对应小程序页面。"
    : typeCopy.description;

const guideSteps =
  link.type === "miniprogram"
    ? ["打开微信扫一扫", "扫描下方二维码", `进入${link.label}页面`]
    : link.type === "wechat_article"
      ? ["打开微信扫一扫", "扫描下方二维码", "在微信内查看文章内容"]
      : ["打开微信扫一扫", "扫描下方二维码", `完成${link.label}访问`];
---

<BaseLayout title={`${link.label} - ${siteConfig.title}`} description={typeCopy.description}>
  <Fragment slot="head">
    {canAutoRedirect ? <meta http-equiv="refresh" content={`0;url=${link.href}`} /> : null}
  </Fragment>

  <main class="min-h-screen bg-[linear-gradient(180deg,#faf7f1_0%,#f7f2eb_100%)] px-5 py-10">
    <div class="mx-auto flex max-w-3xl flex-col gap-6">
      {canAutoRedirect ? (
        <div class="flex min-h-[50vh] flex-col items-center justify-center gap-4 text-center">
          <div class="h-12 w-12 animate-spin rounded-full border-4 border-[#efceb7] border-t-[#d2231f]"></div>
          <div class="text-lg font-bold text-[#8f2318]">{`正在前往 ${link.label}...`}</div>
        </div>
      ) : (
        <section class="go-card">
          <a href="/" class="link-chip mb-6 w-fit">返回首页</a>

          <div class="mb-3 text-sm font-semibold tracking-[0.12em] text-[#c7692f]">
            {typeCopy.eyebrow}
          </div>

          {isScanGuide ? (
            <>
              <h1 class="text-4xl font-extrabold leading-tight text-[#8f2318] max-[640px]:text-[30px]">
                {guideTitle}
              </h1>
              <p class="mt-4 max-w-2xl text-base leading-8 text-[#5b4d45]">{guideDescription}</p>

              <div class="mt-8 overflow-hidden rounded-[32px] border border-[#f0ddd0] bg-[linear-gradient(180deg,#fffaf4_0%,#fff5ec_100%)] shadow-soft">
                <div class="border-b border-[#f2e0d2] bg-[radial-gradient(circle_at_top_right,rgba(255,162,79,0.14),transparent_30%),linear-gradient(180deg,rgba(255,255,255,0.86),rgba(255,250,244,0.72))] px-6 py-6 max-[640px]:px-5">
                  <div class="inline-flex items-center rounded-full bg-[#fff1e4] px-3 py-1 text-xs font-bold tracking-[0.08em] text-[#c85f2a]">
                    微信扫码入口
                  </div>
                  <div class="mt-4 text-[15px] leading-7 text-[#65554a]">
                    请直接扫码进入，如当前设备不便扫码，也可以截图后使用微信扫一扫中的相册识别功能。
                  </div>
                </div>

                <div class="grid gap-6 p-6 md:grid-cols-[240px_1fr] max-[640px]:p-5">
                  <div class="flex flex-col items-center rounded-[28px] border border-[#f1dfd1] bg-white px-5 py-6 shadow-[0_10px_24px_rgba(183,131,86,0.08)]">
                    <div class="mb-4 text-sm font-bold tracking-[0.06em] text-[#a35a2d]">请微信扫码</div>
                    {qrImage ? (
                      <img
                        src={qrImage}
                        alt={link.label}
                        class="h-[190px] w-[190px] rounded-[22px] border-8 border-[#fff4ea] object-cover shadow-[0_8px_20px_rgba(165,101,48,0.12)]"
                      />
                    ) : (
                      <div class="flex h-[190px] w-[190px] items-center justify-center rounded-[22px] border-8 border-[#fff4ea] bg-white p-6 text-center text-sm font-semibold leading-7 text-[#8f2d20] shadow-[0_8px_20px_rgba(165,101,48,0.12)]">
                        二维码图片占位
                        <br />
                        后续可替换真实二维码
                      </div>
                    )}
                    <div class="mt-4 rounded-2xl bg-[#fff8f2] px-4 py-3 text-center text-sm leading-7 text-[#8e7b6d]">
                      推荐在微信内打开，扫码后可直接进入
                    </div>
                  </div>

                  <div class="flex flex-col gap-4">
                    <div class="rounded-[26px] border border-[#f1dfd1] bg-white p-5 shadow-[0_10px_24px_rgba(183,131,86,0.08)]">
                      <div class="text-lg font-bold text-[#7b3827]">使用方式</div>
                      <div class="mt-4 grid gap-3">
                        {guideSteps.map((step, index) => (
                          <div class="flex items-start gap-3 rounded-2xl bg-[#fff8f2] px-4 py-3">
                            <div class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-[linear-gradient(180deg,#ff7f2d,#df2d1e)] text-sm font-bold text-white">
                              {index + 1}
                            </div>
                            <div class="pt-0.5 text-sm leading-6 text-[#68564a]">{step}</div>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div class="rounded-[26px] border border-[#f1dfd1] bg-white p-5 shadow-[0_10px_24px_rgba(183,131,86,0.08)]">
                      <div class="text-lg font-bold text-[#7b3827]">温馨提示</div>
                      <div class="mt-3 text-sm leading-7 text-[#7e6a5d]">
                        {link.type === "miniprogram"
                          ? "若你当前不在微信内，建议先保存二维码，再使用微信扫一扫中的相册入口识别。"
                          : link.note}
                      </div>
                      {link.miniProgramPath ? (
                        <div class="mt-4 rounded-2xl bg-[#fff8f2] px-4 py-3 text-xs leading-6 text-[#9a8678]">
                          当前对应页面：{link.miniProgramPath}
                        </div>
                      ) : null}
                    </div>

                    <div class="flex flex-wrap gap-3">
                      <a class="soft-btn" href="/">返回首页</a>
                    </div>
                  </div>
                </div>
              </div>
            </>
          ) : (
            <>
              <h1 class="mb-4 text-4xl font-extrabold leading-tight text-[#8f2318] max-[640px]:text-[30px]">
                {typeCopy.title}
              </h1>
              <p class="max-w-2xl text-base leading-8 text-[#5b4d45]">{typeCopy.description}</p>

              <div class="mt-8 rounded-3xl border border-[#f0ddd0] bg-[#fffaf5] p-6">
                <div class="mt-6 flex flex-wrap gap-3">
                  {link.href ? (
                    <a class="cta-pill" href={link.href} rel="noreferrer" target="_blank">
                      继续访问
                    </a>
                  ) : (
                    <span class="soft-btn cursor-not-allowed opacity-70">链接待配置</span>
                  )}
                  <a class="soft-btn" href="/">返回首页</a>
                </div>
              </div>
            </>
          )}
        </section>
      )}
    </div>
  </main>

  {canAutoRedirect ? (
    <script define:vars={{ href: link.href }}>
      window.location.replace(href);
    </script>
  ) : null}
</BaseLayout>
